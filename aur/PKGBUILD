# Maintainer: sanne <2246467700@qq.com>
pkgname=mini-mdr-git
pkgver=0.2.21.r3.258591e
pkgrel=1
pkgdesc='A tray-only UPnP/DLNA MediaRenderer with a pluggable player backend'
arch=('x86_64')
url='https://github.com/chenzhenhong/mini-mdr'
license=('MIT')
options=(!debug)
depends=('mpv')
makedepends=('cargo')
source=('git+https://github.com/chenzhenhong/mini-mdr.git'
        'mini-mdr.desktop')
sha256sums=('SKIP'
            'SKIP')

pkgver() {
  cd mini-mdr
  (set -o pipefail; git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-\)g/r\1/;s/-/./g') ||
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd mini-mdr
  cargo build --release --locked
}

check() {
  cd mini-mdr
  cargo test --locked
}

package() {
  cd mini-mdr
  install -Dm755 target/release/mini-mdr "$pkgdir/usr/bin/mini-mdr"
  install -Dm644 resources/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/mini-mdr.png"
  install -Dm644 "$srcdir/mini-mdr.desktop" "$pkgdir/usr/share/applications/mini-mdr.desktop"
}
